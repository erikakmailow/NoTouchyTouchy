#requires -Version 5.1

<#
.SYNOPSIS
    NoTouchyTouchy account investigation module.

.DESCRIPTION
    Inventories local Windows user accounts and identifies
    account characteristics relevant to user activity investigations.

    This module is read-only.

.VERSION
    0.1.0
#>

Set-StrictMode -Version Latest

function Invoke-AccountHunt {

    [CmdletBinding()]
    param()

    Write-Host ""
    Write-Host "===============================================" -ForegroundColor DarkGray
    Write-Host "                ACCOUNT HUNT" -ForegroundColor Cyan
    Write-Host "===============================================" -ForegroundColor DarkGray
    Write-Host ""

    $Findings = @()

    try {

        $Accounts = @(
            Get-CimInstance Win32_UserAccount `
                -Filter "LocalAccount=True" `
                -ErrorAction Stop
        )

    }
    catch {

        Write-Host "[!] Unable to query local user accounts." `
            -ForegroundColor Red

        Write-Host "    Reason: $($_.Exception.Message)" `
            -ForegroundColor Yellow

        return @()
    }

    foreach ($Account in $Accounts) {

        $Username = $Account.Name
        $Domain = $Account.Domain
        $SID = $Account.SID
        $Enabled = $Account.Disabled -eq $false
        $BuiltIn = $Account.LocalAccount -and (
            $Username -eq "Administrator" -or
            $Username -eq "Guest"
        )

        $Description = $Account.Description

        Write-Host "[+] ACCOUNT"
        Write-Host "    User       : $Domain\$Username"
        Write-Host "    Enabled    : $Enabled"
        Write-Host "    Built-In   : $BuiltIn"
        Write-Host "    SID        : $SID"
        Write-Host ""

        $Findings += [PSCustomObject]@{

            DetectionType = "LocalUserAccount"

            User = $Username

            Domain = $Domain

            SID = $SID

            Enabled = $Enabled

            BuiltIn = $BuiltIn

            Description = $Description

            Computer = $env:COMPUTERNAME

            CollectedAt = (
                Get-Date
            ).ToUniversalTime().ToString("o")
        }
    }

    Write-Host "-----------------------------------------------"

    if ($Findings.Count -eq 0) {

        Write-Host "[+] No local accounts discovered." `
            -ForegroundColor Green

    }
    else {

        Write-Host "[+] Local accounts discovered: $($Findings.Count)" `
            -ForegroundColor Green
    }

    Write-Host ""

    return $Findings
}
